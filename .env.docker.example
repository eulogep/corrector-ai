# Corrector AI — environnement Docker de production
# Copier vers .env.production puis renseigner les valeurs réelles.
# Ne jamais committer .env.production ni le dossier .secrets/.

# Au moins un fournisseur de correction est nécessaire ; Gemini est requis pour l'OCR.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Authentification applicative — générer avec : openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Résilience LLM — garder une enveloppe courte pour limiter la latence en production.
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=4

# Optionnel : envoi des rapports PDF par courriel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Ne pas définir METRICS_TOKEN ici.
# Docker Compose le lit depuis .secrets/metrics_token via METRICS_TOKEN_FILE.
