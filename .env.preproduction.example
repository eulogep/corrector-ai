# Corrector AI — préproduction / pilote fermé
# Copier ce fichier vers .env sur l’instance de préproduction, puis renseigner les valeurs réelles hors Git.

# Fournisseurs IA : obligatoires pour tester un flux OCR et correction réel.
GEMINI_API_KEY=
# Modèle multimodal validé par un appel OCR réel ; ne le remplacer qu’après un test fournisseur équivalent.
GEMINI_OCR_MODEL=gemini-3.5-flash
# Repli de notation contrôlé par les mêmes contrats Pydantic stricts.
GEMINI_GRADING_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# Repli OCR multimodal activé si Gemini est indisponible ou refuse la requête.
CLAUDE_OCR_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=

# Sécurité applicative : générer une valeur aléatoire longue propre à la préproduction.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
DEBUG=false

# Observabilité : protéger /metrics avec un jeton distinct de tous les autres secrets.
METRICS_TOKEN=

# Résilience : valeurs prudentes pour le premier pilote.
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=4

# Cache : laisser vide pour le premier test local ; renseigner une instance Redis privée pour le pilote Docker.
REDIS_URL=
SUBJECT_CACHE_TTL_SECONDS=86400

# E-mail : laisser vide durant les tests initiaux. L’application bloque déjà l’envoi d’une copie non validée.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Persistance durable : URL PostgreSQL Supabase avec sslmode=require et rôle de base.
# Ne jamais versionner ces valeurs ; les enregistrer comme secrets Render.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=corrector-private
# En pilote ou production, empêcher tout repli silencieux sur le disque éphémère.
REQUIRE_PERSISTENT_STORAGE=true
